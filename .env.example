# Dùng cho docker-compose.yml ở thư mục gốc. Sao chép thành .env rồi điền giá trị THẬT (không commit .env).
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cổng Portal trên máy chủ. Mặc định 8080 (đổi nếu cổng này đang bị dùng).
PORTAL_PORT=8080

# ---- Khi đặt Nginx (cùng máy) phía trước Portal ----
# Nginx proxy tới 127.0.0.1:PORTAL_PORT -> Portal thấy kết nối đến từ gateway Docker 172.30.0.1.
# Để chỉ Nginx gọi được Portal và Portal tin X-Forwarded-For của Nginx:
#   PORTAL_BIND=127.0.0.1
#   PORTAL_TRUST_PROXY=172.30.0.1
# KHÔNG đặt PORTAL_TRUST_PROXY khi Portal mở ra ngoài (PORTAL_BIND=0.0.0.0): máy trong LAN cũng đi qua gateway đó.
PORTAL_BIND=0.0.0.0
PORTAL_TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
