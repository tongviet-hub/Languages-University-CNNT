# ---- App ----
NODE_ENV=development
PORT=8080
# Danh sách origin được phép gọi API (cách nhau bởi dấu phẩy) - mặc định là Vite dev server
CORS_ORIGINS=http://localhost:5173

# ---- Các dịch vụ phía sau (Portal chỉ biết URL, không có thông tin DB nào) ----
ACADEMIC_URL=http://localhost:8081
FINANCE_URL=http://localhost:8082
# Thời gian chờ tối đa cho mỗi lần gọi dịch vụ con (ms) - đề yêu cầu 2 giây
UPSTREAM_TIMEOUT_MS=2000

# IP/subnet của reverse proxy (Nginx) đứng trước Portal. Để trống/false = không tin X-Forwarded-For của ai.
# Nginx cùng máy, proxy tới 127.0.0.1:8080 -> TRUST_PROXY=loopback
TRUST_PROXY=false
