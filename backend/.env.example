# ---- App ----
NODE_ENV=development
PORT=3000
# Danh sách origin được phép gọi API (cách nhau bởi dấu phẩy) - mặc định là Vite dev server
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5440
DB_USER=school
DB_PASSWORD=school_dev_password
DB_NAME=school_portal
# Chỉ bật ở môi trường dev: tự tạo/sửa bảng theo entity. Production phải dùng migration.
DB_SYNCHRONIZE=true

# ---- JWT (mỗi secret >= 32 ký tự) ----
# Tạo secret ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- Seed (chỉ dùng cho dev) ----
SEED_PASSWORD=Password123!
